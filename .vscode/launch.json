{
    // Two debuggers available:
    //   - cppvsdbg: Microsoft Visual Studio Debugger (ms-vscode.cpptools).
    //     Native handler for Windows PE/PDB; recommended for Bevy projects
    //     on Windows because CodeLLDB has architectural perf issues on
    //     large dependency forests (see CodeLLDB issue #1241).
    //   - lldb: CodeLLDB (vadimcn.vscode-lldb). Kept as fallback / for
    //     unit-test debugging where it works fine.
    //
    // The dev configs use a preLaunchTask to stage runtime DLLs next to
    // the exe (because `bevy/dynamic_linking` makes the exe depend on two
    // DLLs that aren't on PATH when a debugger launches it directly).
    // Release doesn't enable dynamic_linking so it just needs cargo build.
    // Unit-test config still uses CodeLLDB's `cargo` block (cppvsdbg has no
    // equivalent for "build tests then debug the produced binary").
    // Full reasoning lives in `.github/copilot-instructions.md`.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug 'percussion' (dev, cppvsdbg)",
            // 用微软 C/C++ 扩展自带的 Visual Studio Debugger。Rust msvc target
            // 输出 Microsoft PDB，cppvsdbg 是它的"亲生"调试器，对 Windows
            // PE/PDB 处理远比 CodeLLDB (LLDB on Windows) 高效。CodeLLDB 在
            // Bevy 这种大依赖项目上 lldb.exe 持续高 CPU、窗口卡死，issue
            // #1241 vadimcn 本人承认是 LLDB 架构层问题、扩展无法修。
            // 前置：装 ms-vscode.cpptools (Microsoft C/C++) 扩展。
            // 注意：environment 是数组形式，跟 lldb 的 env dict 不一样。
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "dev: build & stage DLLs",
            "program": "${workspaceFolder}/target/debug/percussion.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "environment": [
                {
                    "name": "_NO_DEBUG_HEAP",
                    "value": "1"
                },
                {
                    // F5/LLDB 直拉 exe 不走 cargo，没有 CARGO_MANIFEST_DIR；
                    // Bevy 会 fallback 到 exe 旁边（target/debug/），找不到
                    // assets。这里强制把 base 指回 bin crate 根，跟 cargo run
                    // 表现一致。详见 doc/gotchas.md。
                    "name": "BEVY_ASSET_ROOT",
                    "value": "${workspaceFolder}/crates/percussion"
                }
            ]
        },
        {
            "name": "Debug 'percussion' (dev, lldb)",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "dev: build & stage DLLs",
            "program": "${workspaceFolder}/target/debug/percussion.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            // Windows 在调试器下默认启用 "debug heap"：每次 alloc/free 都做
            // guard 字节填充和追踪，分配/释放速度比裸跑慢 10–100 倍。Bevy 这种
            // 每帧大量小分配的引擎会被严重放大（实测：每帧 spawn/despawn Text2d
            // 时帧时间从微秒级飙到秒级，窗口直接卡死）。下划线开头的环境变量是
            // Windows 进程级开关，CodeLLDB 在 spawn 子进程前注入即可生效。
            // 关闭它只影响 debug heap，不影响 LLDB 自身的断点 / 内存检查能力。
            //
            // BEVY_ASSET_ROOT：跟 cppvsdbg 一份的理由，见上面那条注释。
            "env": {
                "_NO_DEBUG_HEAP": "1",
                "BEVY_ASSET_ROOT": "${workspaceFolder}/crates/percussion"
            }
        },
        {
            "name": "Debug 'percussion' (release, cppvsdbg)",
            // F5 直拉 exe 时 base = current_exe().parent() = target/release/，
            // 找不到 assets。BEVY_ASSET_ROOT 把 base 指向 bin crate 根，让
            // base + "assets" 解析到 crates/percussion/assets/。只影响调试
            // 启动，dist 部署时 exe 旁边带 assets/，不需要这个 env。
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "cargo: build (release)",
            "program": "${workspaceFolder}/target/release/percussion.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "environment": [
                {
                    "name": "_NO_DEBUG_HEAP",
                    "value": "1"
                },
                {
                    "name": "BEVY_ASSET_ROOT",
                    "value": "${workspaceFolder}/crates/percussion"
                }
            ]
        },
        {
            "name": "Debug 'percussion' (release, lldb)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--package=percussion",
                    "--bin=percussion",
                    "--release"
                ],
                "filter": {
                    "name": "percussion",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "BEVY_ASSET_ROOT": "${workspaceFolder}/crates/percussion"
            }
        },
        {
            "name": "Debug unit tests in 'percussion'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=percussion"
                ],
                "filter": {
                    "name": "percussion",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}