{
    // Requires the "CodeLLDB" extension (vadimcn.vscode-lldb).
    //
    // The dev config uses a preLaunchTask to stage runtime DLLs next to the
    // exe (because `bevy/dynamic_linking` makes the exe depend on two DLLs
    // that aren't on PATH when a debugger launches it directly). Release
    // and unit-test configs don't enable dynamic_linking, so they can use
    // CodeLLDB's `cargo` block directly. Full reasoning lives in
    // `.github/copilot-instructions.md`.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug 'percussion' (dev)",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "dev: build & stage DLLs",
            "program": "${workspaceFolder}/target/debug/percussion.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            // Windows 在调试器下默认启用 "debug heap"：每次 alloc/free 都做
            // guard 字节填充和追踪，分配/释放速度比裸跑慢 10–100 倍。Bevy 这种
            // 每帧大量小分配的引擎会被严重放大（实测：每帧 spawn/despawn Text2d
            // 时帧时间从微秒级飙到秒级，窗口直接卡死）。下划线开头的环境变量是
            // Windows 进程级开关，CodeLLDB 在 spawn 子进程前注入即可生效。
            // 关闭它只影响 debug heap，不影响 LLDB 自身的断点 / 内存检查能力。
            "env": {
                "_NO_DEBUG_HEAP": "1"
            }
        },
        {
            "name": "Debug 'percussion' (release)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--package=percussion",
                    "--bin=percussion",
                    "--release"
                ],
                "filter": {
                    "name": "percussion",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug unit tests in 'percussion'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=percussion"
                ],
                "filter": {
                    "name": "percussion",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}