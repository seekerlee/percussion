{
    // ---------- rust-analyzer ----------
    // Run `clippy` on save so lints surface alongside compile errors.
    "rust-analyzer.check.command": "clippy",
    "rust-analyzer.check.extraArgs": [
        "--all-targets"
    ],
    // Make rust-analyzer aware of the `dev` feature so code paths gated on
    // it are checked and completions work when you enable it.
    "rust-analyzer.cargo.features": "all",
    // Don't run `cargo check` while typing — saves CPU on a Bevy-sized graph.
    "rust-analyzer.checkOnSave": true,
    // 关掉 "unlinked-file" 诊断：写新模块时常先建文件再补 `mod` 声明，
    // 这中间窗的灰显 + 报错没有价值；真忘了挂进 mod 树时 `cargo check`
    // 自然会报。
    "rust-analyzer.diagnostics.disabled": [
        "unlinked-file"
    ],
    // Windows DLL fix for rust-analyzer's proc-macro server:
    //
    // proc-macro 服务器跑在 toolchain 的 `libexec/` 下，加载
    // `target/debug/deps/*_macros-*.dll` 时 Windows 找不到这些 DLL 依赖的
    // `std-*.dll`（住在 toolchain 的 `bin/`），inline 报
    // "cannot create expander"。`cargo check` 不受影响（rustc 与 std DLL 同目录）。
    //
    // 把 toolchain `bin/` 前置进 RA 进程的 PATH，子进程（含 proc-macro 服务器）
    // 继承后 DLL 解析能命中 `std-*.dll`。改完需在命令面板执行
    // "rust-analyzer: Restart server" 让设置生效。
    "rust-analyzer.server.extraEnv": {
        "PATH": "${userHome}\\.rustup\\toolchains\\stable-x86_64-pc-windows-msvc\\bin;${env:PATH}"
    },
    // ---------- editor ----------
    "editor.formatOnSave": true,
    "editor.semanticHighlighting.enabled": true,
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.tabSize": 4,
        "editor.rulers": [
            100
        ]
    },
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml",
        "editor.formatOnSave": true
    },
    // ---------- CodeLLDB 调试性能 ----------
    //
    // F5 调试 Bevy + `dynamic_linking` 会出现 CPU 卡 / GPU 闲 ——
    // 画面不别，但窗口几乎不响应。cargo run 同代码丝滑，
    // 说明不是代码 / 游戏逻辑的锁，是调试器本身的开销。
    //
    // 最后锁定的主因是这一项 —— codelldb 默认 PDB reader 是
    // DIA-based（完整但慢），改用 native reader 后 Bevy 依赖森林的
    // 几十个 PDB 加载速度骤增，F5 启动后不再卡。
    //
    // bisect 已证明这一项单独就够；evaluateForHovers / commandCompletions
    // / target.preload-symbols false 都不需要。
    "lldb.useNativePDBReader": true,
    // ---------- file / search exclusions ----------
    // Stop the file watcher and search from chewing through `target/`.
    "files.watcherExclude": {
        "**/target/**": true
    },
    "search.exclude": {
        "**/target": true,
        "**/Cargo.lock": true
    },
    // ---------- 状态栏快捷按钮 (spencerwmiles.vscode-task-buttons) ----------
    // 把最常点的 task 钉在状态栏，避免每次 Ctrl+Shift+P → "Run Task"。
    // `task` 字段必须严格匹配 tasks.json 里的 label。icon 用 VS Code 内置
    // codicon，列表见 https://code.visualstudio.com/api/references/icons-in-labels
    "VsCodeTaskButtons.showCounter": false,
    "VsCodeTaskButtons.tasks": [
        {
            "label": "$(play) Run",
            "task": "cargo: run (dev, dynamic linking)",
            "tooltip": "cargo run --features dev"
        },
        {
            "label": "$(tools) Tasks",
            "tooltip": "其他常用 cargo task",
            "tasks": [
                {
                    "label": "$(checklist) Clippy (deny warnings)",
                    "task": "cargo: clippy (deny warnings)",
                    "description": "cargo clippy --workspace --all-targets -- -D warnings"
                },
                {
                    "label": "$(beaker) Test",
                    "task": "cargo: test (workspace)",
                    "description": "cargo test --workspace"
                },
                {
                    "label": "$(symbol-keyword) Fmt",
                    "task": "cargo: fmt",
                    "description": "cargo fmt --all"
                },
                {
                    "label": "$(rocket) Run (release)",
                    "task": "cargo: run (release)",
                    "description": "cargo run --release"
                },
                {
                    "label": "$(package) Build (release)",
                    "task": "cargo: build (release)",
                    "description": "cargo build --release"
                }
            ]
        }
    ]
}